 tei/candidates.jsonl | 1 +
 2 files changed, 7 insertions(+), 3 deletions(-)

diff --git a/kgcompass/repair.py b/kgcompass/repair.py
index 8b773c5..cd5bf7a 100644
--- a/kgcompass/repair.py
+++ b/kgcompass/repair.py
@@ -33,9 +33,12 @@ def applable_patch(*args, **kwargs):
         result = False
     if not result:
         return False
-    whitespace = subprocess.run(
-        ['git', 'diff', '--check'], capture_output=True, text=True
-    )
+    try:
+        whitespace = subprocess.run(
+            ['git', 'diff', '--check'], capture_output=True, text=True
+        )
+    except (OSError, subprocess.SubprocessError):
+        return False
     if whitespace.returncode != 0:
         return False
     changed = subprocess.run(
