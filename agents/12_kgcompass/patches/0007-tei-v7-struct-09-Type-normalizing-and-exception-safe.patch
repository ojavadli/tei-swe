From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:37:41 -0700
Subject: [PATCH 07/28] tei-v7 struct-09: Type-normalizing and exception-safe
 edit-command boundary

---
 kgcompass/repair.py  | 11 +++++++++--
 tei/candidates.jsonl |  1 +
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/kgcompass/repair.py b/kgcompass/repair.py
index 278b7fe..6301bf8 100644
--- a/kgcompass/repair.py
+++ b/kgcompass/repair.py
@@ -24,9 +24,16 @@ from utils import (
 
 def parse_diff_edit_commands_strict(*args, **kwargs):
     try:
-        return _parse_diff_edit_commands_strict(*args, **kwargs)
-    except (ValueError, TypeError, IndexError):
+        parsed = _parse_diff_edit_commands_strict(*args, **kwargs)
+    except Exception:
         return []
+    if parsed is None:
+        return []
+    if isinstance(parsed, dict):
+        parsed = [parsed]
+    if not isinstance(parsed, list):
+        return []
+    return [item for item in parsed if isinstance(item, dict) and item]
 
 from benchmark import create_benchmark_manager
 
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 76a51fa..54bf92d 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -5,3 +5,4 @@
 {"version_id": "struct-05", "phase": "structural", "technique": "Treat syntax-checker exceptions as validation failures instead of process failures", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch,\n)\nfrom benchmark import create_benchmark_manager", "replace": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax as _check_syntax,\n    applable_patch,\n)\n\ndef check_syntax(*args, **kwargs):\n    try:\n        return _check_syntax(*args, **kwargs)\n    except (OSError, subprocess.SubprocessError, ValueError, TypeError):\n        return False\n\nfrom benchm"}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.63, "execution_accuracy": 0.6, "output_integrity": 0.68}, "aggregate": 0.6475, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.92}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.24}, {"instance_id": "django__django-11964", "score": 0.24}], "score_label": "PROXY", "decision": "proposed_not_applied", "apply_note": "find-block matched 0x (need exactly 1)", "delta_vs_baseline": 0.02, "why": "Treating syntax-checker exceptions as failed validation is a useful safety boundary: invalid candidates can be rejected or retried instead of terminating orchestration. This improves execution and integrity more than parser-only handling, though it still does not repair the generated patch."}
 {"version_id": "struct-06", "phase": "structural", "technique": "Make patch-application errors return a failed candidate status", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch,\n)\nfrom benchmark import create_benchmark_manager", "replace": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch as _applable_patch,\n)\n\ndef applable_patch(*args, **kwargs):\n    try:\n        return _applable_patch(*args, **kwargs)\n    except (OSError, subprocess.SubprocessError, ValueError, TypeError):\n        return False\n\nfrom "}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.63, "execution_accuracy": 0.61, "output_integrity": 0.69}, "aggregate": 0.6525, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.92}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.26}, {"instance_id": "django__django-11964", "score": 0.25}], "score_label": "PROXY", "decision": "proposed_not_applied", "apply_note": "find-block matched 0x (need exactly 1)", "delta_vs_baseline": 0.025, "why": "Converting patch-application exceptions into explicit failed-candidate results most directly addresses brittle execution and allows orchestration to retry or select another candidate. It improves reliability and integrity, but cannot increase success when the underlying patch is intrinsically incorrect."}
 {"version_id": "struct-07", "phase": "structural", "technique": "Defensive multi-format localization-result decoding", "target_failure_mode": "Brittle output and orchestration handling", "expected_dimension": "output_integrity", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/llm_loc.py", "find": "def extract_json_code(text):\n    try:\n        return _extract_json_code(text)\n    except (ValueError, TypeError, json.JSONDecodeError):\n        return {}", "replace": "def extract_json_code(text):\n    if not isinstance(text, str):\n        return {}\n    candidates = [text]\n    candidates.extend(re.findall(r\"```(?:json)?\\\\s*(.*?)```\", text, flags=re.S | re.I))\n    for candidate in candidates:\n        try:\n            parsed = _extract_json_code(candidate)\n            if isinstance(parsed, dict) and parsed:\n                return parsed\n        except (ValueError, "}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.62, "execution_accuracy": 0.59, "output_integrity": 0.69}, "aggregate": 0.645, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.91}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.25}, {"instance_id": "django__django-11964", "score": 0.24}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0175, "why": "The defensive decoder directly reduces malformed localization-result handling and modestly improves downstream execution, but it does not improve localization quality or patch reasoning. The improvement is limited because decoding fallback cannot recover missing or semantically incorrect results."}
+{"version_id": "struct-08", "phase": "structural", "technique": "Fail-closed instance and language grounding before localization", "target_failure_mode": "Fault-localization or context-selection misses", "expected_dimension": "target_alignment", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/llm_loc.py", "find": "self.target_sample = self._load_target_sample()\n        if self.target_sample:\n            self.language = self.target_sample.get('language', 'python').lower()", "replace": "self.target_sample = self._load_target_sample()\n        if not self.target_sample:\n            raise ValueError(f\"Unable to load benchmark instance: {self.instance_id}\")\n        self.language = str(self.target_sample.get('language') or 'python').lower()\n        if self.language not in {'python', 'java'}:\n            self.language = 'python'"}, "dimensions": {"target_alignment": 0.73, "reasoning_soundness": 0.65, "execution_accuracy": 0.59, "output_integrity": 0.65}, "aggregate": 0.655, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.92}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.29}, {"instance_id": "django__django-11964", "score": 0.27}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0275, "why": "Failing closed when the benchmark target cannot be loaded prevents localization against the wrong instance, and explicit language grounding improves context selection. It raises target alignment most clearly, though the strict language gate can reject unsupported cases rather than solve them."}
