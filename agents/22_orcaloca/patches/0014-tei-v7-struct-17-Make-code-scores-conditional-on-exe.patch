 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/Orcar/code_scorer.py b/Orcar/code_scorer.py
index 5b016df..a2d65e8 100644
--- a/Orcar/code_scorer.py
+++ b/Orcar/code_scorer.py
@@ -22,7 +22,7 @@ CODE_SCORER_SYSTEM_PROMPT = (
 )
 
 CODE_SCORER_ORDER_PROMPT = (
-    "Score this code from 0 to 100 using: 40 points for direct causal evidence, "
+    "First reject any candidate that lacks a concrete failing execution path, a falsifiable explanation of the violated semantic invariant, or a regression-test oracle; only then score surviving candidates from 0 to 100 using: 40 points for direct causal evidence, "
