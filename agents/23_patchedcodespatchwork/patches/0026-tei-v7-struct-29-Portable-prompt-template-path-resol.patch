 resolution

---
 patchwork/steps/PreparePrompt/PreparePrompt.py | 4 +++-
 tei/candidates.jsonl                           | 1 +
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/patchwork/steps/PreparePrompt/PreparePrompt.py b/patchwork/steps/PreparePrompt/PreparePrompt.py
index 1ae9712..1e6003e 100644
--- a/patchwork/steps/PreparePrompt/PreparePrompt.py
+++ b/patchwork/steps/PreparePrompt/PreparePrompt.py
@@ -17,7 +17,9 @@ def _find_by_prompt_template_file(prompt_template_file: str | None, prompt_id: s
         logger.warning("PromptId is empty after normalization")
         return None
 
-    prompt_template_file = Path(prompt_template_file)
+    prompt_template_file = Path(prompt_template_file).expanduser()
+    if not prompt_template_file.is_absolute():
+        prompt_template_file = (Path.cwd() / prompt_template_file).resolve()
     if not prompt_template_file.is_file():
         logger.warning(f"PromptTemplateFile[{prompt_template_file}] does not exist")
         return None
