Subject: [PATCH 13/29] tei-v7 struct-15: Add a permissive structured-output
 fallback around strict ed

---
 kgcompass/repair.py  | 26 +++++++++++++++++++-------
 tei/candidates.jsonl |  1 +
 2 files changed, 20 insertions(+), 7 deletions(-)

diff --git a/kgcompass/repair.py b/kgcompass/repair.py
index 4f861c0..df1f4a6 100644
--- a/kgcompass/repair.py
+++ b/kgcompass/repair.py
@@ -35,14 +35,26 @@ def parse_diff_edit_commands_strict(*args, **kwargs):
     try:
         parsed = _parse_diff_edit_commands_strict(*args, **kwargs)
     except Exception:
-        return []
-    if parsed is None:
-        return []
+        parsed = None
     if isinstance(parsed, dict):
-        parsed = [parsed]
-    if not isinstance(parsed, list):
-        return []
-    return [item for item in parsed if isinstance(item, dict) and item]
+        return [parsed]
+    if isinstance(parsed, list):
+        return [item for item in parsed if isinstance(item, dict) and item]
+    for value in args:
+        if not isinstance(value, str):
+            continue
+        candidate = value.strip()
+        if "```" in candidate:
+            candidate = candidate.replace("```json", "").replace("```", "").strip()
+        try:
+            parsed = json.loads(candidate)
+        except (TypeError, ValueError, json.JSONDecodeError):
+            continue
+        if isinstance(parsed, dict):
+            return [parsed]
+        if isinstance(parsed, list):
+            return [item for item in parsed if isinstance(item, dict) and item]
+    return []
 
 from benchmark import create_benchmark_manager
 
