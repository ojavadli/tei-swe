@@ -2,3 +2,4 @@
 {"version_id": "struct-02", "phase": "structural", "technique": "Prepend an explicit reconnaissance step to every generated plan", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "    def __init__(self, initial_plan: Optional[list[str]] = None):\n        self.__plan = initial_plan or []\n        self.__cursor = 0", "replace": "    def __init__(self, initial_plan: Optional[list[str]] = None):\n        reconnaissance = \"Inspect repository structure, relevant symbols, neighboring implementations, and existing tests\"\n        self.__plan = [reconnaissance, *(initial_plan or [])]\n        self.__cursor = 0"}, "dimensions": {"target_alignment": 0.65, "reasoning_soundness": 0.6, "execution_accuracy": 0.47, "output_integrity": 0.55}, "aggregate": 0.5675, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.21}, {"instance_id": "django__django-11910", "score": 0.19}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.02, "why": "Adding reconnaissance makes plans more repository-aware and modestly improves issue targeting. However, it only prepends a textual step, does not ensure that reconnaissance is actually performed, and can consume planning capacity without improving patch execution or validation."}
 {"version_id": "struct-03", "phase": "structural", "technique": "Make plan advancement idempotent at the end of the plan", "target_failure_mode": "Unreliable multi-step patch execution", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "    def advance(self) -> bool:\n        self.__cursor += 1\n        return self.__cursor < len(self.__plan)", "replace": "    def advance(self) -> bool:\n        if self.__cursor < len(self.__plan):\n            self.__cursor += 1\n        return self.__cursor < len(self.__plan)"}, "dimensions": {"target_alignment": 0.62, "reasoning_soundness": 0.57, "execution_accuracy": 0.49, "output_integrity": 0.54}, "aggregate": 0.555, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.78}, {"instance_id": "sympy__sympy-15011", "score": 0.76}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0075, "why": "The advancement method already guards against moving past the end of the plan, so the change provides little new protection. It earns only a small execution gain for clarifying end-state behavior and does not address repository understanding or completion validation."}
 {"version_id": "struct-04", "phase": "structural", "technique": "Expose an explicit plan-completion predicate to the planning agent", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "    def is_empty(self) -> bool:\n        return len(self.__plan) == 0\n\n    def register_steps(self, agent: Agent):\n        agent.tool_plain(self.get_current_plan)\n        agent.tool_plain(self.get_current_step)\n        agent.tool_plain(self.get_current_step_index)\n        agent.tool_plain(self.add_step)\n        agent.tool_plain(self.delete_step)", "replace": "    def is_empty(self) -> bool:\n        return len(self.__plan) == 0\n\n    def is_complete(self) -> bool:\n        return bool(self.__plan) and self.__cursor >= len(self.__plan)\n\n    def register_steps(self, agent: Agent):\n        agent.tool_plain(self.get_current_plan)\n        agent.tool_plain(self.get_current_step)\n        agent.tool_plain(self.get_current_step_index)\n        agent.tool_plain(self"}, "dimensions": {"target_alignment": 0.63, "reasoning_soundness": 0.6, "execution_accuracy": 0.48, "output_integrity": 0.6}, "aggregate": 0.5775, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.21}, {"instance_id": "django__django-11910", "score": 0.2}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.03, "why": "An explicit completion predicate gives the planning agent a clearer terminal state and reduces premature completion claims. It improves output integrity and reasoning modestly, but it does not itself require tests, inspect diffs, or verify the actual patch."}
+{"version_id": "struct-05", "phase": "structural", "technique": "Require completion claims to carry validation evidence", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "output_integrity", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "class ExecutionResult(BaseModel):\n    json_data: str\n    message: str\n    is_completed: bool", "replace": "class ExecutionResult(BaseModel):\n    json_data: str\n    message: str\n    is_completed: bool\n    validation_evidence: str = \"\"\n\n    @property\n    def completion_is_credible(self) -> bool:\n        return not self.is_completed or bool(self.validation_evidence.strip())"}, "dimensions": {"target_alignment": 0.62, "reasoning_soundness": 0.58, "execution_accuracy": 0.45, "output_integrity": 0.61}, "aggregate": 0.565, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.77}, {"instance_id": "sympy__sympy-15011", "score": 0.75}, {"instance_id": "django__django-11001", "score": 0.19}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0175, "why": "Requiring validation evidence is the strongest direct improvement to completion reporting and raises output integrity. However, evidence is only checked for non-emptiness rather than substantive correctness, and gating completion claims can reduce execution throughput or reject otherwise valid results."}
