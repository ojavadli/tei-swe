 {"version_id": "struct-27", "phase": "structural", "technique": "Treat patch-tool and filesystem errors as failed attempts rather than aborting orchestration", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "    try:\n        result = _applable_patch(*args, **kwargs)\n    except (OSError, subprocess.CalledProcessError, ValueError):\n        result = False", "replace": "    try:\n        result = _applable_patch(*args, **kwargs)\n    except Exception:\n        result = False"}, "dimensions": {"target_alignment": 0.69, "reasoning_soundness": 0.61, "execution_accuracy": 0.61, "output_integrity": 0.65}, "aggregate": 0.64, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.9}, {"instance_id": "django__django-12747", "score": 0.9}, {"instance_id": "django__django-13768", "score": 0.25}, {"instance_id": "django__django-11964", "score": 0.24}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0125, "why": "Converting patch-tool exceptions into failed attempts improves orchestration resilience and gives retries or alternate attempts a chance. Broad exception swallowing can hide programming and filesystem defects, so reasoning soundness improves little and execution gains remain modest."}
 {"version_id": "struct-28", "phase": "structural", "technique": "Make post-application whitespace verification failure-safe", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "    whitespace = subprocess.run(\n        ['git', 'diff', '--check'], capture_output=True, text=True\n    )", "replace": "    try:\n        whitespace = subprocess.run(\n            ['git', 'diff', '--check'], capture_output=True, text=True\n        )\n    except (OSError, subprocess.SubprocessError):\n        return False"}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.63, "execution_accuracy": 0.55, "output_integrity": 0.65}, "aggregate": 0.6275, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.89}, {"instance_id": "django__django-12747", "score": 0.89}, {"instance_id": "django__django-13768", "score": 0.19}, {"instance_id": "django__django-11964", "score": 0.2}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0, "why": "Failure-safe whitespace checking avoids an orchestration crash, but returning false when subprocess verification is unavailable can reject otherwise usable patches and reduce execution accuracy. It provides only a small integrity benefit and is below baseline overall."}
 {"version_id": "struct-29", "phase": "structural", "technique": "Provide a tokenizer compatibility fallback for environments without tiktoken", "target_failure_mode": "Brittle output and orchestration handling", "expected_dimension": "output_integrity", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair_claude.py", "find": "import tiktoken", "replace": "try:\n    import tiktoken\nexcept ImportError:\n    class _FallbackEncoding:\n        def encode(self, text):\n            return text.split()\n        def decode(self, tokens):\n            return ' '.join(tokens)\n    class _FallbackTiktoken:\n        @staticmethod\n        def get_encoding(_name):\n            return _FallbackEncoding()\n    tiktoken = _FallbackTiktoken()"}, "dimensions": {"target_alignment": 0.65, "reasoning_soundness": 0.57, "execution_accuracy": 0.52, "output_integrity": 0.56}, "aggregate": 0.575, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.86}, {"instance_id": "django__django-12747", "score": 0.87}, {"instance_id": "django__django-13768", "score": 0.16}, {"instance_id": "django__django-11964", "score": 0.17}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": -0.0525, "why": "The fallback prevents an import-time failure, but whitespace tokenization is not tokenizer-compatible and decode reintroduces spacing changes that can corrupt code or token budgets. This is a brittle compatibility workaround and scores below baseline on execution and output integrity."}
