Subject: [PATCH 23/27] tei-v7 struct-26: Deterministic tool-schema ordering

---
 patchwork/common/multiturn_strategy/agentic_strategy.py | 5 ++++-
 tei/candidates.jsonl                                    | 1 +
 2 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/patchwork/common/multiturn_strategy/agentic_strategy.py b/patchwork/common/multiturn_strategy/agentic_strategy.py
index cd8381a..370f76a 100644
--- a/patchwork/common/multiturn_strategy/agentic_strategy.py
+++ b/patchwork/common/multiturn_strategy/agentic_strategy.py
@@ -23,7 +23,10 @@ class Role(abc.ABC):
         self.llm_client = llm_client
         self.tool_set = {
             name: tool
-            for name, tool in tool_set.items()
+            for name, tool in sorted(
+                tool_set.items(),
+                key=lambda item: (item[0] == "end", item[0]),
+            )
             if tool is not None
         }
         self.history: list[ChatCompletionMessageParam] = [{
