Subject: [PATCH 22/27] tei-v7 struct-25: Repository-aware bootstrap
 instruction

---
 .../common/multiturn_strategy/agentic_strategy.py      | 10 +++++++++-
 tei/candidates.jsonl                                   |  1 +
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/patchwork/common/multiturn_strategy/agentic_strategy.py b/patchwork/common/multiturn_strategy/agentic_strategy.py
index 48fddf1..cd8381a 100644
--- a/patchwork/common/multiturn_strategy/agentic_strategy.py
+++ b/patchwork/common/multiturn_strategy/agentic_strategy.py
@@ -26,7 +26,15 @@ class Role(abc.ABC):
             for name, tool in tool_set.items()
             if tool is not None
         }
-        self.history: list[ChatCompletionMessageParam] = []
+        self.history: list[ChatCompletionMessageParam] = [{
+            "role": "system",
+            "content": (
+                "First identify the repository, framework and version, issue type, relevant "
+                "conventions, and expected behavior. Inspect analogous code and tests before "
+                "editing. Make the smallest compatible patch, then run focused tests and "
+                "report concrete validation evidence."
+            ),
+        }]
         self.request_tokens = 0
         self.response_tokens = 0
 
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 077739b..1f05141 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -21,3 +21,4 @@
 {"version_id": "struct-21", "phase": "structural", "technique": "Reject completed execution results without an execution message", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "output_integrity", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "class ExecutionResult(BaseModel):", "replace": "class ExecutionResult(BaseModel):\n    @field_validator(\"is_completed\")\n    @classmethod\n    def completed_requires_execution_evidence(cls, value, info):\n        message = str(info.data.get(\"message\", \"\")).strip()\n        if value and not message:\n            raise ValueError(\"Completed executions must include evidence in message\")\n        return value"}, "dimensions": {"target_alignment": 0.62, "reasoning_soundness": 0.56, "execution_accuracy": 0.47, "output_integrity": 0.59}, "aggregate": 0.56, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.19}, {"instance_id": "django__django-11910", "score": 0.17}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0125, "why": "Requiring an execution message prevents a class of empty completion claims and modestly improves output integrity, but a message is weak evidence and the change does not validate the actual patch or tests."}
 {"version_id": "struct-22", "phase": "structural", "technique": "Sanitize the tool registry before agent execution", "target_failure_mode": "Unreliable multi-step patch execution", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/agentic_strategy.py", "find": "        self.tool_set = tool_set", "replace": "        self.tool_set = {\n            name: tool\n            for name, tool in tool_set.items()\n            if tool is not None\n        }"}, "dimensions": {"target_alignment": 0.61, "reasoning_soundness": 0.57, "execution_accuracy": 0.5, "output_integrity": 0.54}, "aggregate": 0.555, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0075, "why": "Removing null tools avoids failures during multi-step execution and gives a small execution-accuracy gain, but silently shrinking the tool set can remove needed capabilities and does not address validation or repository reasoning."}
 {"version_id": "struct-23", "phase": "structural", "technique": "Reinitialize the system instruction when conversation state is malformed", "target_failure_mode": "Unreliable multi-step patch execution", "expected_dimension": "reasoning_soundness", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/agentic_strategy.py", "find": "        if not self.history:", "replace": "        if not self.history or self.history[0].get(\"role\") != \"system\":"}, "dimensions": {"target_alignment": 0.6, "reasoning_soundness": 0.55, "execution_accuracy": 0.5, "output_integrity": 0.53}, "aggregate": 0.545, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.78}, {"instance_id": "sympy__sympy-15011", "score": 0.76}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": -0.0025, "why": "Restoring a missing system message can recover malformed conversations and slightly improve execution robustness, but reinitializing state risks discarding useful context, lowering reasoning and output reliability."}
+{"version_id": "struct-24", "phase": "structural", "technique": "Normalize prompt identifiers before template lookup", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/steps/PreparePrompt/PreparePrompt.py", "find": "    if prompt_template_file is None or prompt_id is None:\n        return None", "replace": "    if prompt_template_file is None or prompt_id is None:\n        return None\n    prompt_id = prompt_id.strip()\n    if not prompt_id:\n        logger.warning(\"PromptId is empty after normalization\")\n        return None"}, "dimensions": {"target_alignment": 0.67, "reasoning_soundness": 0.59, "execution_accuracy": 0.47, "output_integrity": 0.54}, "aggregate": 0.5675, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.02, "why": "Normalization improves robustness across prompt identifier formatting and directly addresses generalization, especially for heterogeneous repositories, but it only fixes lookup hygiene and does not improve patch execution or completion validation."}
