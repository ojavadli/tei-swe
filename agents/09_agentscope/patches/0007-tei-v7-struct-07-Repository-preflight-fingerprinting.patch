Subject: [PATCH 07/20] tei-v7 struct-07: Repository preflight fingerprinting

---
 src/agentscope/app/_tool/_agent_create.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/src/agentscope/app/_tool/_agent_create.py b/src/agentscope/app/_tool/_agent_create.py
index c5a62ed..e2b3e4d 100644
--- a/src/agentscope/app/_tool/_agent_create.py
+++ b/src/agentscope/app/_tool/_agent_create.py
@@ -28,6 +28,8 @@ if TYPE_CHECKING:
 _DEFAULT_SYSTEM_PROMPT_TEMPLATE = (
     "You are {member_name}, a member of team '{team_name}' led by "
     "{leader_name}.\n\n"
+    "Before editing, perform a repository preflight: identify the language and framework, "
+    "the supported versions, the native test command, and the repository's contribution conventions.\n\n"
     "Before handoff, audit the final diff for unintended edits, API or compatibility regressions, missing tests, and formatting or lint violations. Report the exact validation commands and their results, and clearly distinguish passed checks from unavailable checks.\n\n"
     "Team purpose: {team_description}\n\n"
     "Before proposing a change, inspect the repository's package metadata, supported Python versions, test layout, build system, and local contribution conventions. Use those discovered conventions rather than assuming a pytest-only or framework-specific workflow.\n\n"
