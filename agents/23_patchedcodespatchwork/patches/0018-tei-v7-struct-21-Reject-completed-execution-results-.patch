From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:41:38 -0700
Subject: [PATCH 18/28] tei-v7 struct-21: Reject completed execution results
 without an execution mess

---
 patchwork/common/multiturn_strategy/planning_strategy.py | 7 +++++++
 tei/candidates.jsonl                                     | 1 +
 2 files changed, 8 insertions(+)

diff --git a/patchwork/common/multiturn_strategy/planning_strategy.py b/patchwork/common/multiturn_strategy/planning_strategy.py
index 7329178..6c6ab74 100644
--- a/patchwork/common/multiturn_strategy/planning_strategy.py
+++ b/patchwork/common/multiturn_strategy/planning_strategy.py
@@ -41,6 +41,13 @@ class PlanCompletedResult(BaseModel):
 
 
 class ExecutionResult(BaseModel):
+    @field_validator("is_completed")
+    @classmethod
+    def completed_requires_execution_evidence(cls, value, info):
+        message = str(info.data.get("message", "")).strip()
+        if value and not message:
+            raise ValueError("Completed executions must include evidence in message")
+        return value
     json_data: str
     message: str
     is_completed: bool
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 31c1435..832cc80 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -17,3 +17,4 @@
 {"version_id": "struct-17", "phase": "structural", "technique": "Step-level validation evidence propagation", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "class StepCompletedResult(BaseModel):\n    is_step_completed: bool", "replace": "class StepCompletedResult(BaseModel):\n    is_step_completed: bool\n    validation_evidence: str = \"\"\n\n    @property\n    def completion_is_credible(self) -> bool:\n        return not self.is_step_completed or bool(self.validation_evidence.strip())"}, "dimensions": {"target_alignment": 0.62, "reasoning_soundness": 0.57, "execution_accuracy": 0.48, "output_integrity": 0.58}, "aggregate": 0.5625, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.19}, {"instance_id": "django__django-11910", "score": 0.17}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.015, "why": "Requiring nonempty evidence for completed steps is a useful but shallow guard against unsupported completion claims. It improves handoff integrity modestly, while the lack of evidence quality checks limits gains in execution and validation."}
 {"version_id": "struct-18", "phase": "structural", "technique": "Prompt-template format normalization", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/steps/PreparePrompt/PreparePrompt.py", "find": "    try:\n        with open(prompt_template_file, \"r\") as fp:\n            prompt_templates = json.load(fp)\n    except json.JSONDecodeError as e:\n        logger.warning(f\"Invalid Json at PromptTemplateFile[{prompt_template_file}]\")\n        return None", "replace": "    try:\n        with open(prompt_template_file, \"r\", encoding=\"utf-8\") as fp:\n            prompt_templates = json.load(fp)\n    except (OSError, json.JSONDecodeError) as e:\n        logger.warning(f\"Unable to load PromptTemplateFile[{prompt_template_file}]: {e}\")\n        return None\n\n    if isinstance(prompt_templates, dict):\n        prompt_templates = prompt_templates.get(\"prompts\", [prompt_templa"}, "dimensions": {"target_alignment": 0.65, "reasoning_soundness": 0.59, "execution_accuracy": 0.48, "output_integrity": 0.55}, "aggregate": 0.5675, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.8}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.21}, {"instance_id": "django__django-11910", "score": 0.19}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.02, "why": "More defensive prompt-template loading and format normalization can reduce configuration-driven behavior differences across repositories, helping generalization and modestly improving reasoning setup. It is infrastructure-level and does not ensure correct edits, tests, or completion validation."}
 {"version_id": "struct-19", "phase": "structural", "technique": "Enforce evidence at step-result construction time", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "output_integrity", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "class StepCompletedResult(BaseModel):\n    is_step_completed: bool\n    validation_evidence: str = \"\"", "replace": "class StepCompletedResult(BaseModel):\n    is_step_completed: bool\n    validation_evidence: str = \"\"\n\n    @field_validator(\"validation_evidence\")\n    @classmethod\n    def require_evidence_for_completed_step(cls, value, info):\n        if info.data.get(\"is_step_completed\") and not value.strip():\n            raise ValueError(\"Completed steps must include validation evidence\")\n        return value"}, "dimensions": {"target_alignment": 0.63, "reasoning_soundness": 0.58, "execution_accuracy": 0.48, "output_integrity": 0.61}, "aggregate": 0.575, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.8}, {"instance_id": "sympy__sympy-15011", "score": 0.78}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.19}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0275, "why": "Directly targets missing validation at step completion and improves output integrity, though evidence can be superficial and may reject valid completions without strong contextual checks."}
+{"version_id": "struct-20", "phase": "structural", "technique": "Require comprehensive plan-level validation markers", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "output_integrity", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "@property\n    def completion_is_credible(self) -> bool:\n        if not self.is_plan_completed:\n            return True\n        evidence = self.validation_evidence.strip().lower()\n        required_markers = (\"file\", \"change\", \"test\", \"diff\", \"validation\")\n        return bool(evidence) and any(marker in evidence for marker in required_markers)", "replace": "@property\n    def completion_is_credible(self) -> bool:\n        if not self.is_plan_completed:\n            return True\n        evidence = self.validation_evidence.strip().lower()\n        required_markers = (\"file\", \"change\", \"test\", \"diff\", \"validation\")\n        return bool(evidence) and all(marker in evidence for marker in required_markers)"}, "dimensions": {"target_alignment": 0.63, "reasoning_soundness": 0.54, "execution_accuracy": 0.46, "output_integrity": 0.57}, "aggregate": 0.55, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.18}, {"instance_id": "django__django-11910", "score": 0.17}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0025, "why": "The completion property is aimed at validation credibility, but requiring all generic markers is brittle and may not be enforced by the execution path, reducing reasoning soundness and offering little practical execution benefit."}
