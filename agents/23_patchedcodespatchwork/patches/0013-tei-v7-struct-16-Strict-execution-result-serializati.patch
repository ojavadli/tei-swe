From 7dc99e0bfb61ce9121ab5b7e8d28396095532c30 Mon Sep 17 00:00:00 2001
From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:40:54 -0700
Subject: [PATCH 13/27] tei-v7 struct-16: Strict execution-result serialization

---
 patchwork/common/multiturn_strategy/planning_strategy.py | 8 +++++++-
 tei/candidates.jsonl                                     | 1 +
 2 files changed, 8 insertions(+), 1 deletion(-)

diff --git a/patchwork/common/multiturn_strategy/planning_strategy.py b/patchwork/common/multiturn_strategy/planning_strategy.py
index b2a0e42..d54e15e 100644
--- a/patchwork/common/multiturn_strategy/planning_strategy.py
+++ b/patchwork/common/multiturn_strategy/planning_strategy.py
@@ -36,9 +36,15 @@ class ExecutionResult(BaseModel):
 
     @field_validator("json_data")
     @classmethod
-    def json_data_must_not_be_blank(cls, value: str) -> str:
+    def json_data_must_be_valid_object(cls, value: str) -> str:
         if not value.strip():
             raise ValueError("json_data must contain the execution result")
+        try:
+            parsed = json.loads(value)
+        except JSONDecodeError as exc:
+            raise ValueError("json_data must contain valid JSON") from exc
+        if not isinstance(parsed, dict):
+            raise ValueError("json_data must contain a JSON object")
         return value
 
     @property
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 5d34c2c..f54d7af 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -12,3 +12,4 @@
 {"version_id": "struct-12", "phase": "structural", "technique": "Non-empty structured execution output", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "output_integrity", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "class ExecutionResult(BaseModel):\n    json_data: str\n    message: str\n    is_completed: bool\n    validation_evidence: str = \"\"", "replace": "class ExecutionResult(BaseModel):\n    json_data: str\n    message: str\n    is_completed: bool\n    validation_evidence: str = \"\"\n\n    @field_validator(\"json_data\")\n    @classmethod\n    def json_data_must_not_be_blank(cls, value: str) -> str:\n        if not value.strip():\n            raise ValueError(\"json_data must contain the execution result\")\n        return value"}, "dimensions": {"target_alignment": 0.61, "reasoning_soundness": 0.56, "execution_accuracy": 0.44, "output_integrity": 0.6}, "aggregate": 0.5525, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.77}, {"instance_id": "sympy__sympy-20154", "score": 0.75}, {"instance_id": "django__django-11001", "score": 0.15}, {"instance_id": "django__django-11910", "score": 0.13}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.005, "why": "The active nonblank-field validator is the clearest output-integrity enforcement and can reject empty execution responses. However, nonempty json_data is not necessarily valid or useful evidence, while stricter schema rejection can interrupt execution without improving patch correctness; targeting and execution therefore fall below baseline."}
 {"version_id": "struct-13", "phase": "structural", "technique": "Repository-adaptive reconnaissance contract", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/agentic_strategy.py", "find": "                \"content\": \"Work repository-first: inspect the target repository's conventions, neighboring implementations, tests, and supported versions before editing. Prefer the smallest compatible patch and verify it with focused tests.\"\n", "replace": "                \"content\": \"Before reasoning about the fix, identify the repository, framework/version, issue type, and local conventions. Inspect the relevant implementation, neighboring code, history or compatibility constraints, and existing tests. Do not transfer assumptions from another repository; state the observed evidence that connects the issue to the proposed change. Prefer the smallest"}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.62, "execution_accuracy": 0.47, "output_integrity": 0.55}, "aggregate": 0.58, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.8}, {"instance_id": "sympy__sympy-15011", "score": 0.78}, {"instance_id": "django__django-11001", "score": 0.23}, {"instance_id": "django__django-11910", "score": 0.21}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0325, "why": "Repository- and issue-aware reconnaissance directly addresses the main generalization failure and should improve problem framing, especially on the Django probes. It does not materially strengthen patch execution or final validation."}
 {"version_id": "struct-14", "phase": "structural", "technique": "Transactional edit-and-verify agent protocol", "target_failure_mode": "Unreliable multi-step patch execution", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/agentic_strategy.py", "find": "        if not self.history:\n            self.history.append({\n                \"role\": \"system\",\n                \"content\": \"Work repository-first: inspect the target repository's conventions, neighboring implementations, tests, and supported versions before editing. Prefer the smallest compatible patch and verify it with focused tests.\"\n            })", "replace": "        if not self.history:\n            self.history.append({\n                \"role\": \"system\",\n                \"content\": \"Execute as a transaction: (1) inspect and reproduce the issue, (2) identify the smallest change, (3) apply the edit, (4) reread the diff and affected files, (5) run focused tests or an explicit substitute, and (6) only then report completion. After every tool result, check w"}, "dimensions": {"target_alignment": 0.63, "reasoning_soundness": 0.6, "execution_accuracy": 0.53, "output_integrity": 0.6}, "aggregate": 0.59, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.81}, {"instance_id": "sympy__sympy-15011", "score": 0.79}, {"instance_id": "django__django-11001", "score": 0.23}, {"instance_id": "django__django-11910", "score": 0.21}], "score_label": "PROXY", "decision": "proposed_not_applied", "apply_note": "find-block matched 0x (need exactly 1)", "delta_vs_baseline": 0.0425, "why": "The transactional sequence adds reproduction, minimal-edit discipline, diff rereading, and focused testing, making it the strongest direct intervention for unreliable multi-step execution. The protocol is somewhat prompt-dependent and cannot fully solve repository misdiagnosis."}
+{"version_id": "struct-15", "phase": "structural", "technique": "Evidence-gated plan completion", "target_failure_mode": "Insufficient completion or validation of final changes", "expected_dimension": "output_integrity", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "    @property\n    def completion_is_credible(self) -> bool:\n        return not self.is_plan_completed or bool(self.validation_evidence.strip())", "replace": "    @property\n    def completion_is_credible(self) -> bool:\n        if not self.is_plan_completed:\n            return True\n        evidence = self.validation_evidence.strip().lower()\n        required_markers = (\"file\", \"change\", \"test\", \"diff\", \"validation\")\n        return bool(evidence) and any(marker in evidence for marker in required_markers)"}, "dimensions": {"target_alignment": 0.62, "reasoning_soundness": 0.57, "execution_accuracy": 0.46, "output_integrity": 0.55}, "aggregate": 0.55, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.78}, {"instance_id": "sympy__sympy-15011", "score": 0.76}, {"instance_id": "django__django-11001", "score": 0.18}, {"instance_id": "django__django-11910", "score": 0.16}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0025, "why": "The completion check is weak because it accepts evidence containing any one of several generic markers rather than requiring meaningful validation. It adds little protection and can create false confidence, so scores remain essentially at baseline."}
