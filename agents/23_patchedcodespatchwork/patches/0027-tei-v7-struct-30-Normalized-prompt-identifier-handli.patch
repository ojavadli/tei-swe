diff --git a/patchwork/steps/PreparePrompt/PreparePrompt.py b/patchwork/steps/PreparePrompt/PreparePrompt.py
index 1e6003e..3269cde 100644
--- a/patchwork/steps/PreparePrompt/PreparePrompt.py
+++ b/patchwork/steps/PreparePrompt/PreparePrompt.py
@@ -12,7 +12,7 @@ from patchwork.step import Step, StepStatus
 def _find_by_prompt_template_file(prompt_template_file: str | None, prompt_id: str | None) -> list[dict] | None:
     if prompt_template_file is None or prompt_id is None:
         return None
-    prompt_id = prompt_id.strip()
+    prompt_id = " ".join(prompt_id.strip().split())
     if not prompt_id:
         logger.warning("PromptId is empty after normalization")
         return None
