Subject: [PATCH 21/51] tei-v7 struct-24: Reduce concurrent relevance pressure
 to improve completion r

---
 codemonkeys/stages/context/relevance.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/codemonkeys/stages/context/relevance.py b/codemonkeys/stages/context/relevance.py
index 3c46ce3..21962af 100644
--- a/codemonkeys/stages/context/relevance.py
+++ b/codemonkeys/stages/context/relevance.py
@@ -20,7 +20,7 @@ class RelevanceConfig(CodeMonkeysConfigWithLLM):
 
         # Keep concurrent context decisions below provider/container pressure so
         # relevance calls finish reliably and downstream agents receive feedback.
-        self.max_workers = 32
+        self.max_workers = 16
         self.max_tokens = 8192
         self.timeout = 7200.0
 
