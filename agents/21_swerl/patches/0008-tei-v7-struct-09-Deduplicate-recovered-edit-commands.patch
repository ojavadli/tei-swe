Subject: [PATCH 08/10] tei-v7 struct-09: Deduplicate recovered edit commands
 while preserving their f

---
 src/swerl/agentless_mini/repair.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/src/swerl/agentless_mini/repair.py b/src/swerl/agentless_mini/repair.py
index 01bc3e3..5834b9e 100644
--- a/src/swerl/agentless_mini/repair.py
+++ b/src/swerl/agentless_mini/repair.py
@@ -31,7 +31,10 @@ def _resilient_extract_python_blocks(raw_output: str):
             recovered.extend(_primary_extract_python_blocks(block))
         except Exception:
             continue
-    return recovered
+    unique = {}
+    for command in recovered:
+        unique.setdefault(repr(command), command)
+    return list(unique.values())
 
 
 utils.data.extract_python_blocks = _resilient_extract_python_blocks
