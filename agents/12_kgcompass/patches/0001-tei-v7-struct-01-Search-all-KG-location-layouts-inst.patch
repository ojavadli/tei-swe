 kgcompass/llm_loc.py   |   6 +-
 tei/baseline_eval.json |  81 +++++++++++++++
 tei/candidates.jsonl   |   0
 tei/onboarding.json    | 230 +++++++++++++++++++++++++++++++++++++++++
 4 files changed, 316 insertions(+), 1 deletion(-)
 create mode 100644 tei/baseline_eval.json
 create mode 100644 tei/candidates.jsonl
 create mode 100644 tei/onboarding.json

diff --git a/kgcompass/llm_loc.py b/kgcompass/llm_loc.py
index 2778635..743d503 100644
--- a/kgcompass/llm_loc.py
+++ b/kgcompass/llm_loc.py
@@ -34,7 +34,11 @@ class PreFaultLocalization:
         import glob
         
         # 查找 KG location 文件
-        kg_location_files = glob.glob(f"tests/{self.instance_id}_*/kg_locations/{self.instance_id}.json")
+        kg_location_files = sorted(set(
+            glob.glob(f"tests/{self.instance_id}_*/kg_locations/{self.instance_id}.json")
+            + glob.glob(f"tests/**/{self.instance_id}.json", recursive=True)
+            + glob.glob(f"**/kg_locations/{self.instance_id}.json", recursive=True)
+        ))
         
         if kg_location_files:
             # 从 KG location 文件中提取样本信息
