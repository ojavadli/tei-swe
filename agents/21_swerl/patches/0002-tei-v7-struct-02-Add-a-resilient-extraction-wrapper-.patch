Date: Sat, 8 Aug 2026 13:18:05 -0700
Subject: [PATCH 02/10] tei-v7 struct-02: Add a resilient extraction wrapper
 that retries parsing fenc

---
 src/swerl/agentless_mini/repair.py | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/src/swerl/agentless_mini/repair.py b/src/swerl/agentless_mini/repair.py
index cda4a11..6a204b6 100644
--- a/src/swerl/agentless_mini/repair.py
+++ b/src/swerl/agentless_mini/repair.py
@@ -12,8 +12,32 @@ from typing import TypeVar
 from datasets import Dataset
 from tqdm.auto import tqdm
 
+import re
+
 import swerl.agentless_mini.utils as utils
 
+_primary_extract_python_blocks = utils.data.extract_python_blocks
+
+
+def _resilient_extract_python_blocks(raw_output: str):
+    try:
+        commands = _primary_extract_python_blocks(raw_output)
+    except Exception:
+        commands = []
+    if commands:
+        return commands
+    recovered = []
+    blocks = re.findall(r"```(?:python)?\\s*(.*?)```", raw_output, flags=re.IGNORECASE | re.DOTALL)
+    for block in blocks:
+        try:
+            recovered.extend(_primary_extract_python_blocks(block))
+        except Exception:
+            continue
+    return recovered
+
+
+utils.data.extract_python_blocks = _resilient_extract_python_blocks
+
 
 @dataclass(frozen=True)
 class Args:
