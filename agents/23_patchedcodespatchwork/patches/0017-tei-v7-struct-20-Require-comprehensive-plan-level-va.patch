Subject: [PATCH 17/27] tei-v7 struct-20: Require comprehensive plan-level
 validation markers

---
 patchwork/common/multiturn_strategy/planning_strategy.py | 2 +-
 tei/candidates.jsonl                                     | 1 +
 2 files changed, 2 insertions(+), 1 deletion(-)

diff --git a/patchwork/common/multiturn_strategy/planning_strategy.py b/patchwork/common/multiturn_strategy/planning_strategy.py
index ab92383..7329178 100644
--- a/patchwork/common/multiturn_strategy/planning_strategy.py
+++ b/patchwork/common/multiturn_strategy/planning_strategy.py
@@ -37,7 +37,7 @@ class PlanCompletedResult(BaseModel):
             return True
         evidence = self.validation_evidence.strip().lower()
         required_markers = ("file", "change", "test", "diff", "validation")
-        return bool(evidence) and any(marker in evidence for marker in required_markers)
+        return bool(evidence) and all(marker in evidence for marker in required_markers)
 
 
 class ExecutionResult(BaseModel):
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index e2bb229..31c1435 100644
