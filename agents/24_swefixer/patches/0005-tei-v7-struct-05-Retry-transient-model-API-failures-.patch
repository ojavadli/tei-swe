@@ -45,12 +45,19 @@ def get_model_prediction(client, input_text, system_prompt=None, timeout=300, te
                     },
                     {"role": "user", "content": input_text},
                 ]
-            response = client.chat.completions.create(
-                model=model_name,
-                messages=message,
-                temperature=temp,
-                top_p=1,
