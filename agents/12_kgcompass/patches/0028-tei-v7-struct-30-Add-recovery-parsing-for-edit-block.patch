From b15c502465cd621384326acb665e4d6bd109bd3e Mon Sep 17 00:00:00 2001
From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:39:51 -0700
Subject: [PATCH 28/29] tei-v7 struct-30: Add recovery parsing for edit blocks
 after strict diff-comma

---
 kgcompass/repair.py  | 23 ++++++++++++++++++++++-
 tei/candidates.jsonl |  1 +
 2 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/kgcompass/repair.py b/kgcompass/repair.py
index cd5bf7a..18fbf5a 100644
--- a/kgcompass/repair.py
+++ b/kgcompass/repair.py
@@ -21,11 +21,32 @@ from utils import (
     format_entity_content,
     extract_python_blocks,
     split_edit_multifile_commands,
-    parse_diff_edit_commands_strict as _parse_diff_edit_commands_strict,
+    parse_diff_edit_commands_strict as _strict_parse_diff_edit_commands,
     check_syntax,
     applable_patch as _applable_patch,
 )
 
+def _parse_diff_edit_commands_strict(*args, **kwargs):
+    try:
+        result = _strict_parse_diff_edit_commands(*args, **kwargs)
+        if result:
+            return result
+    except (OSError, ValueError, TypeError, IndexError):
+        pass
+    text_index = next((i for i, value in enumerate(args) if isinstance(value, str)), None)
+    if text_index is None:
+        return []
+    for block in extract_python_blocks(args[text_index]):
+        retry_args = list(args)
+        retry_args[text_index] = block
+        try:
+            result = _strict_parse_diff_edit_commands(*retry_args, **kwargs)
+            if result:
+                return result
+        except (OSError, ValueError, TypeError, IndexError):
+            continue
+    return []
+
 def applable_patch(*args, **kwargs):
     try:
         result = _applable_patch(*args, **kwargs)
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 2e7ec6b..54f0582 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -26,3 +26,4 @@
