 {"version_id": "struct-21", "phase": "structural", "technique": "Make localization JSON recovery tolerate non-JSON decoding exceptions", "target_failure_mode": "Brittle output and orchestration handling", "expected_dimension": "output_integrity", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/llm_loc.py", "find": "            except json.JSONDecodeError:\n                continue", "replace": "            except (json.JSONDecodeError, TypeError, ValueError):\n                continue"}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.62, "execution_accuracy": 0.58, "output_integrity": 0.66}, "aggregate": 0.635, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.9}, {"instance_id": "django__django-12747", "score": 0.9}, {"instance_id": "django__django-13768", "score": 0.21}, {"instance_id": "django__django-11964", "score": 0.21}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0075, "why": "Catching TypeError and other decoding-related failures prevents localization recovery from aborting, but JSONDecodeError already covers the principal decoding path, so the practical gain is small."}
 {"version_id": "struct-22", "phase": "structural", "technique": "Convert patch-application exceptions into a controlled failed attempt", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "    result = _applable_patch(*args, **kwargs)", "replace": "    try:\n        result = _applable_patch(*args, **kwargs)\n    except (OSError, subprocess.CalledProcessError, ValueError):\n        result = False"}, "dimensions": {"target_alignment": 0.67, "reasoning_soundness": 0.61, "execution_accuracy": 0.56, "output_integrity": 0.65}, "aggregate": 0.6225, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.89}, {"instance_id": "django__django-12747", "score": 0.89}, {"instance_id": "django__django-13768", "score": 0.2}, {"instance_id": "django__django-11964", "score": 0.2}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": -0.005, "why": "Converting application exceptions into False avoids orchestration crashes, but silently swallowing patch failures does not produce a repair and can hide actionable errors, reducing execution reliability relative to baseline."}
