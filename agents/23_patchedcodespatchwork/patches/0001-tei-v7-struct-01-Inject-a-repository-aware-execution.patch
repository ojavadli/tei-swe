 .../multiturn_strategy/agentic_strategy.py    |   5 +
 tei/baseline_eval.json                        |  81 ++++++
 tei/candidates.jsonl                          |   0
 tei/onboarding.json                           | 260 ++++++++++++++++++
 4 files changed, 346 insertions(+)
 create mode 100644 tei/baseline_eval.json
 create mode 100644 tei/candidates.jsonl
 create mode 100644 tei/onboarding.json

diff --git a/patchwork/common/multiturn_strategy/agentic_strategy.py b/patchwork/common/multiturn_strategy/agentic_strategy.py
index 10b5a0a..14316a4 100644
--- a/patchwork/common/multiturn_strategy/agentic_strategy.py
+++ b/patchwork/common/multiturn_strategy/agentic_strategy.py
@@ -27,6 +27,11 @@ class Role(abc.ABC):
         self.response_tokens = 0
 
     def generate_reply(self, message: str) -> str:
+        if not self.history:
+            self.history.append({
+                "role": "system",
+                "content": "Work repository-first: inspect the target repository's conventions, neighboring implementations, tests, and supported versions before editing. Prefer the smallest compatible patch and verify it with focused tests."
+            })
         self.history.append(dict(role="user", content=message))
         input_kwargs = dict(
             messages=self.history,
