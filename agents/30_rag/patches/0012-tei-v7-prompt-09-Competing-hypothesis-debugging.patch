 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/swebench/inference/run_api.py b/swebench/inference/run_api.py
index 8e47b73..f5ef379 100755
--- a/swebench/inference/run_api.py
+++ b/swebench/inference/run_api.py
@@ -16,7 +16,7 @@ import tiktoken
 import openai
 from anthropic import HUMAN_PROMPT as _HUMAN_PROMPT, AI_PROMPT as _AI_PROMPT, Anthropic
 
-HUMAN_PROMPT = _HUMAN_PROMPT + "\n\n[BEGIN SWE-BENCH TASK]\n\nWORKFLOW REQUIREMENTS:\n1. Convert the issue into an acceptance contract: list each requested behavior, affected API or user-visible output, compatibility constraint, regression risk, and explicit non-goals. Mark every item as either directly stated in the issue or inferred from repository evidence. Do not begin editing until each item has a concrete way to verify it.\n2. For each acceptance-contract item, trace the behavior from its public entry point through relevant callers, state transitions, and error or edge-case paths. Cite concrete repository evidence for the proposed edit, inspect analogous implementations and nearby tests, and record which callers must remain unchanged. Treat patterns from other issues or repositories as hypotheses only, not as evidence.\n3. Before editing, state one falsifiable root-cause hypothesis and the evidence that supports it; reject alternatives that conflict with the code or tests.\n4. Make the smallest production change that satisfies every checklist item while preserving established APIs, conventions, and unaffected behavior.\n5. After editing, map every checklist item to a focused validation command and its observed result; do not finalize if any item is unverified.\n"
+HUMAN_PROMPT = _HUMAN_PROMPT + "\n\n[BEGIN SWE-BENCH TASK]\n\nWORKFLOW REQUIREMENTS:\n1. Convert the issue into an acceptance contract: list each requested behavior, affected API or user-visible output, compatibility constraint, regression risk, and explicit non-goals. Mark every item as either directly stated in the issue or inferred from repository evidence. Do not begin editing until each item has a concrete way to verify it.\n2. For each acceptance-contract item, trace the behavior from its public entry point through relevant callers, state transitions, and error or edge-case paths. Cite concrete repository evidence for the proposed edit, inspect analogous implementations and nearby tests, and record which callers must remain unchanged. Treat patterns from other issues or repositories as hypotheses only, not as evidence.\n3. Before editing, state one falsifiable root-cause hypothesis, the exact code or test evidence supporting it, and at least one competing hypothesis. Perform the smallest inspection or test that distinguishes them, then reject alternatives only when repository evidence rules them out. Re-check assumptions against this repository's conventions, supported versions, and test utilities rather than importing conventions from another project.\n4. Make the smallest production change that satisfies every checklist item while preserving established APIs, conventions, and unaffected behavior.\n5. After editing, map every checklist item to a focused validation command and its observed result; do not finalize if any item is unverified.\n"
 AI_PROMPT = "\n[END SWE-BENCH TASK]\n\nFINAL OUTPUT CONTRACT:\nReturn exactly one applicable unified diff in the final response. Include repository-relative file paths and sufficient context for patch application. Do not include Markdown fences, explanatory prose, test logs, or edits to tests unless the task explicitly requires them. If no change is needed, return an empty diff rather than inventing a file.\n" + _AI_PROMPT
 from tenacity import retry as _retry, stop_after_attempt, wait_random_exponential
 
