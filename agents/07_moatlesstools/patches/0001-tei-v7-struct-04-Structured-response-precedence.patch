Subject: [PATCH 1/4] tei-v7 struct-04: Structured response precedence

---
 moatless/utils/completion_parser.py | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/moatless/utils/completion_parser.py b/moatless/utils/completion_parser.py
index 0ded434..ce81c67 100644
--- a/moatless/utils/completion_parser.py
+++ b/moatless/utils/completion_parser.py
@@ -26,7 +26,7 @@ def parse_completion(completion_data: Dict[str, Any]) -> CompletionDTO:
     )
 
     # Parse from original_response if it exists
-    original_response = completion_data.get("original_response") or completion_data.get("original_response_obj")
+    original_response = completion_data.get("original_response_obj")\n    if original_response is None:\n        original_response = completion_data.get("original_response")
     if original_response:
         if isinstance(original_response, str):
             completion_dto.output = CompletionOutput(content=original_response)
