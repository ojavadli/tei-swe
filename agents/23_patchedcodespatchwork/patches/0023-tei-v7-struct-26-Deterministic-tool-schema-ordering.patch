 {"version_id": "struct-24", "phase": "structural", "technique": "Normalize prompt identifiers before template lookup", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/steps/PreparePrompt/PreparePrompt.py", "find": "    if prompt_template_file is None or prompt_id is None:\n        return None", "replace": "    if prompt_template_file is None or prompt_id is None:\n        return None\n    prompt_id = prompt_id.strip()\n    if not prompt_id:\n        logger.warning(\"PromptId is empty after normalization\")\n        return None"}, "dimensions": {"target_alignment": 0.67, "reasoning_soundness": 0.59, "execution_accuracy": 0.47, "output_integrity": 0.54}, "aggregate": 0.5675, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.02, "why": "Normalization improves robustness across prompt identifier formatting and directly addresses generalization, especially for heterogeneous repositories, but it only fixes lookup hygiene and does not improve patch execution or completion validation."}
