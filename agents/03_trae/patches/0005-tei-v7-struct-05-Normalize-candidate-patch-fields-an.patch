From 1674e88fd7fb4a21e1626d084599751083c3b863 Mon Sep 17 00:00:00 2001
From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:40:26 -0700
Subject: [PATCH 05/40] tei-v7 struct-05: Normalize candidate patch fields and
 provide safe fallbacks

---
 .../patch_selection/trae_selector/selector_agent.py       | 8 ++++----
 tei/candidates.jsonl                                      | 1 +
 2 files changed, 5 insertions(+), 4 deletions(-)

diff --git a/evaluation/patch_selection/trae_selector/selector_agent.py b/evaluation/patch_selection/trae_selector/selector_agent.py
index 585062e..4b5d81e 100755
--- a/evaluation/patch_selection/trae_selector/selector_agent.py
+++ b/evaluation/patch_selection/trae_selector/selector_agent.py
@@ -14,10 +14,10 @@ from .sandbox import Sandbox
 class CandidatePatch:
     def __init__(self, id, patch, cleaned_patch, is_success_regression, is_success_patch):
         self.id = id
-        self.patch = patch
-        self.cleaned_patch = cleaned_patch
-        self.is_success_regression = is_success_regression
-        self.is_success_patch = is_success_patch
+        self.patch = patch if isinstance(patch, str) else ""
+        self.cleaned_patch = cleaned_patch.strip() if isinstance(cleaned_patch, str) else self.patch
+        self.is_success_regression = bool(is_success_regression)
+        self.is_success_patch = bool(is_success_patch)
 
 
 def build_system_prompt(candidate_length: int) -> str:
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 4612ecf..1a300ab 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -1,3 +1,4 @@
 {"version_id": "struct-01", "phase": "structural", "technique": "Inject a mandatory repository-diagnosis phase into the agent's system instructions", "target_failure_mode": "Complex repository-specific diagnosis and implementation", "expected_dimension": "reasoning_soundness", "evidence_instance_ids": ["scikit-learn__scikit-learn-15100", "pytest-dev__pytest-7432", "django__django-16938", "astropy__astropy-13033"], "patch_or_prompt": {"file": "trae_agent/agent/trae_agent.py", "find": "from trae_agent.prompt.agent_prompt import TRAE_AGENT_SYSTEM_PROMPT", "replace": "from trae_agent.prompt.agent_prompt import TRAE_AGENT_SYSTEM_PROMPT\n\nTRAE_AGENT_SYSTEM_PROMPT = TRAE_AGENT_SYSTEM_PROMPT + \"\"\"\n\nBefore editing, perform a repository-specific diagnosis: trace the relevant call path, identify the owning abstraction and nearby compatibility constraints, inspect analogous implementations, and state the smallest behavior change that satisfies the issue. Do not patch un"}, "dimensions": {"target_alignment": 0.9, "reasoning_soundness": 0.87, "execution_accuracy": 0.82, "output_integrity": 0.88}, "aggregate": 0.8675, "probe_scores": [{"instance_id": "scikit-learn__scikit-learn-15100", "score": 0.96}, {"instance_id": "pytest-dev__pytest-7432", "score": 0.96}, {"instance_id": "django__django-16938", "score": 0.29}, {"instance_id": "astropy__astropy-13033", "score": 0.26}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0325, "why": "The mandatory call-path and abstraction diagnosis directly addresses repository-specific failures, improving issue targeting and reasoning. It provides less direct benefit than an execution loop for validation, so gains on the difficult probes remain moderate."}
 {"version_id": "struct-02", "phase": "structural", "technique": "Inject a bounded reproduce-test-debug loop into the agent's system instructions", "target_failure_mode": "Insufficient validation and iterative debugging", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["scikit-learn__scikit-learn-15100", "pytest-dev__pytest-7432", "django__django-16938", "astropy__astropy-13033"], "patch_or_prompt": {"file": "trae_agent/agent/trae_agent.py", "find": "from trae_agent.prompt.agent_prompt import TRAE_AGENT_SYSTEM_PROMPT", "replace": "from trae_agent.prompt.agent_prompt import TRAE_AGENT_SYSTEM_PROMPT\n\nTRAE_AGENT_SYSTEM_PROMPT = TRAE_AGENT_SYSTEM_PROMPT + \"\"\"\n\nUse an iterative validation loop after every substantive edit: run the narrowest reproducer or focused test, inspect the complete failure, revise the patch, and rerun it. Before finishing, run relevant regression tests and continue debugging until the result is passing or"}, "dimensions": {"target_alignment": 0.87, "reasoning_soundness": 0.85, "execution_accuracy": 0.85, "output_integrity": 0.88}, "aggregate": 0.8625, "probe_scores": [{"instance_id": "scikit-learn__scikit-learn-15100", "score": 0.96}, {"instance_id": "pytest-dev__pytest-7432", "score": 0.97}, {"instance_id": "django__django-16938", "score": 0.3}, {"instance_id": "astropy__astropy-13033", "score": 0.29}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0275, "why": "The bounded reproduce-test-debug loop materially improves validation and iterative correction, especially for complex Django and Astropy behavior. It does not itself improve initial diagnosis or contract reconstruction as much as the more targeted reasoning changes."}
 {"version_id": "struct-03", "phase": "structural", "technique": "Add an explicit compatibility and regression checklist to the agent's system instructions", "target_failure_mode": "Edge-case and regression handling", "expected_dimension": "target_alignment", "evidence_instance_ids": ["scikit-learn__scikit-learn-15100", "pytest-dev__pytest-7432", "django__django-16938", "astropy__astropy-13033"], "patch_or_prompt": {"file": "trae_agent/agent/trae_agent.py", "find": "from trae_agent.prompt.agent_prompt import TRAE_AGENT_SYSTEM_PROMPT", "replace": "from trae_agent.prompt.agent_prompt import TRAE_AGENT_SYSTEM_PROMPT\n\nTRAE_AGENT_SYSTEM_PROMPT = TRAE_AGENT_SYSTEM_PROMPT + \"\"\"\n\nFor framework and scientific-library changes, check edge conditions explicitly: empty and null inputs, boundary values, subclass or alternate implementation paths, backwards-compatible defaults, error behavior, and interactions with existing public APIs. Preserve unrelate"}, "dimensions": {"target_alignment": 0.88, "reasoning_soundness": 0.85, "execution_accuracy": 0.82, "output_integrity": 0.9}, "aggregate": 0.8625, "probe_scores": [{"instance_id": "scikit-learn__scikit-learn-15100", "score": 0.96}, {"instance_id": "pytest-dev__pytest-7432", "score": 0.96}, {"instance_id": "django__django-16938", "score": 0.27}, {"instance_id": "astropy__astropy-13033", "score": 0.31}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0275, "why": "The explicit compatibility checklist improves regression awareness and scientific-library edge-case handling, with the clearest benefit on Astropy. It is less effective for discovering the correct repository-specific implementation or debugging a failing patch."}
+{"version_id": "struct-04", "phase": "structural", "technique": "Make patch selection require behavioral evidence rather than surface-level plausibility", "target_failure_mode": "Insufficient validation and iterative debugging", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["scikit-learn__scikit-learn-15100", "pytest-dev__pytest-7432", "django__django-16938", "astropy__astropy-13033"], "patch_or_prompt": {"file": "evaluation/patch_selection/trae_selector/selector_agent.py", "find": "    init_prompt = f\"\"\"\\\n# ROLE: Act as an expert code evaluator. Given a codebase, an github issue and **{candidate_length} candidate patches** proposed by your colleagues, your responsibility is to **select the correct one** to solve the issue.\n\n# WORK PROCESS:", "replace": "    init_prompt = f\"\"\"\\\n# ROLE: Act as an expert code evaluator. Given a codebase, a GitHub issue, and **{candidate_length} candidate patches** proposed by your colleagues, select the patch that actually solves the issue.\n\n# EVIDENCE GATE:\nReject patches that are merely plausible. Prefer candidates with focused test evidence, regression evidence, and a clear explanation of why the failing behavior"}, "dimensions": {"target_alignment": 0.89, "reasoning_soundness": 0.87, "execution_accuracy": 0.84, "output_integrity": 0.89}, "aggregate": 0.8725, "probe_scores": [{"instance_id": "scikit-learn__scikit-learn-15100", "score": 0.96}, {"instance_id": "pytest-dev__pytest-7432", "score": 0.96}, {"instance_id": "django__django-16938", "score": 0.33}, {"instance_id": "astropy__astropy-13033", "score": 0.3}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0375, "why": "Requiring behavioral evidence makes patch selection less vulnerable to plausible but incorrect candidates, improving target alignment and execution outcomes. The gain is limited because the selector still depends on the candidates' available tests and evidence."}
