From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:58:14 -0700
Subject: [PATCH 11/51] tei-v7 struct-14: Expand the step state into a typed
 failure contract and patc

---
 Orcar/prompts.py | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/Orcar/prompts.py b/Orcar/prompts.py
index 5aa4c46..1f6ce49 100644
--- a/Orcar/prompts.py
+++ b/Orcar/prompts.py
@@ -4,10 +4,17 @@ STEP_EXAMPLE = {
         "expected_behavior": "",
         "constraints": [],
         "likely_execution_path": [],
+        "failure_contract": {
+            "trigger": "",
+            "actual_observation": "",
+            "expected_observation": "",
+            "violated_invariant": ""
+        },
         "reproduction_obligations": [
             "minimal input that triggers the bug",
             "expected versus actual result or exception",
-            "semantic invariants that must remain true after the fix"
+            "semantic invariants that must remain true after the fix",
+            "test command or executable oracle that distinguishes the fixed behavior"
         ]
     },
     "observation_feedback": "For every observation, record newly supported and contradicted hypotheses, the exact symbol or call edge it establishes, and the next action with the highest expected information gain.",
