From c1736ea3c2f41aa287f612f1ff7070f94904ec26 Mon Sep 17 00:00:00 2001
From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:39:34 -0700
Subject: [PATCH 04/28] tei-v7 struct-04: Expose an explicit plan-completion
 predicate to the planning

---
 patchwork/common/multiturn_strategy/planning_strategy.py | 4 ++++
 tei/candidates.jsonl                                     | 1 +
 2 files changed, 5 insertions(+)

diff --git a/patchwork/common/multiturn_strategy/planning_strategy.py b/patchwork/common/multiturn_strategy/planning_strategy.py
index 175b4ca..6efb7bd 100644
--- a/patchwork/common/multiturn_strategy/planning_strategy.py
+++ b/patchwork/common/multiturn_strategy/planning_strategy.py
@@ -39,10 +39,14 @@ class _Plan:
     def is_empty(self) -> bool:
         return len(self.__plan) == 0
 
+    def is_complete(self) -> bool:
+        return bool(self.__plan) and self.__cursor >= len(self.__plan)
+
     def register_steps(self, agent: Agent):
         agent.tool_plain(self.get_current_plan)
         agent.tool_plain(self.get_current_step)
         agent.tool_plain(self.get_current_step_index)
+        agent.tool_plain(self.is_complete)
         agent.tool_plain(self.add_step)
         agent.tool_plain(self.delete_step)
 
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index ebe2ff9..ade200c 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -1,2 +1,3 @@
 {"version_id": "struct-01", "phase": "structural", "technique": "Inject a repository-aware execution contract into every agent conversation", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/agentic_strategy.py", "find": "    def generate_reply(self, message: str) -> str:\n        self.history.append(dict(role=\"user\", content=message))\n        input_kwargs = dict(", "replace": "    def generate_reply(self, message: str) -> str:\n        if not self.history:\n            self.history.append({\n                \"role\": \"system\",\n                \"content\": \"Work repository-first: inspect the target repository's conventions, neighboring implementations, tests, and supported versions before editing. Prefer the smallest compatible patch and verify it with focused tests.\"\n         "}, "dimensions": {"target_alignment": 0.67, "reasoning_soundness": 0.62, "execution_accuracy": 0.5, "output_integrity": 0.57}, "aggregate": 0.59, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.81}, {"instance_id": "sympy__sympy-15011", "score": 0.79}, {"instance_id": "django__django-11001", "score": 0.23}, {"instance_id": "django__django-11910", "score": 0.21}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0425, "why": "The repository-aware contract directly addresses cross-repository generalization by requiring inspection of conventions, neighboring code, tests, and supported versions. It improves target selection and reasoning most, with smaller gains in execution and output discipline, but it remains prompt guidance rather than enforced behavior."}
 {"version_id": "struct-02", "phase": "structural", "technique": "Prepend an explicit reconnaissance step to every generated plan", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "    def __init__(self, initial_plan: Optional[list[str]] = None):\n        self.__plan = initial_plan or []\n        self.__cursor = 0", "replace": "    def __init__(self, initial_plan: Optional[list[str]] = None):\n        reconnaissance = \"Inspect repository structure, relevant symbols, neighboring implementations, and existing tests\"\n        self.__plan = [reconnaissance, *(initial_plan or [])]\n        self.__cursor = 0"}, "dimensions": {"target_alignment": 0.65, "reasoning_soundness": 0.6, "execution_accuracy": 0.47, "output_integrity": 0.55}, "aggregate": 0.5675, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.79}, {"instance_id": "sympy__sympy-15011", "score": 0.77}, {"instance_id": "django__django-11001", "score": 0.21}, {"instance_id": "django__django-11910", "score": 0.19}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.02, "why": "Adding reconnaissance makes plans more repository-aware and modestly improves issue targeting. However, it only prepends a textual step, does not ensure that reconnaissance is actually performed, and can consume planning capacity without improving patch execution or validation."}
+{"version_id": "struct-03", "phase": "structural", "technique": "Make plan advancement idempotent at the end of the plan", "target_failure_mode": "Unreliable multi-step patch execution", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/planning_strategy.py", "find": "    def advance(self) -> bool:\n        self.__cursor += 1\n        return self.__cursor < len(self.__plan)", "replace": "    def advance(self) -> bool:\n        if self.__cursor < len(self.__plan):\n            self.__cursor += 1\n        return self.__cursor < len(self.__plan)"}, "dimensions": {"target_alignment": 0.62, "reasoning_soundness": 0.57, "execution_accuracy": 0.49, "output_integrity": 0.54}, "aggregate": 0.555, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.78}, {"instance_id": "sympy__sympy-15011", "score": 0.76}, {"instance_id": "django__django-11001", "score": 0.2}, {"instance_id": "django__django-11910", "score": 0.18}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0075, "why": "The advancement method already guards against moving past the end of the plan, so the change provides little new protection. It earns only a small execution gain for clarifying end-state behavior and does not address repository understanding or completion validation."}
