Subject: [PATCH 21/27] tei-v7 struct-24: Normalize prompt identifiers before
 template lookup

---
 patchwork/steps/PreparePrompt/PreparePrompt.py | 4 ++++
 tei/candidates.jsonl                           | 1 +
 2 files changed, 5 insertions(+)

diff --git a/patchwork/steps/PreparePrompt/PreparePrompt.py b/patchwork/steps/PreparePrompt/PreparePrompt.py
index 66cc17a..1ae9712 100644
--- a/patchwork/steps/PreparePrompt/PreparePrompt.py
+++ b/patchwork/steps/PreparePrompt/PreparePrompt.py
@@ -12,6 +12,10 @@ from patchwork.step import Step, StepStatus
 def _find_by_prompt_template_file(prompt_template_file: str | None, prompt_id: str | None) -> list[dict] | None:
     if prompt_template_file is None or prompt_id is None:
         return None
+    prompt_id = prompt_id.strip()
+    if not prompt_id:
+        logger.warning("PromptId is empty after normalization")
+        return None
 
     prompt_template_file = Path(prompt_template_file)
     if not prompt_template_file.is_file():
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index e6c2e61..077739b 100644
