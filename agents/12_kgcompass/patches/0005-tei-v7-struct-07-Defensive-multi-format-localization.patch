Subject: [PATCH 05/29] tei-v7 struct-07: Defensive multi-format
 localization-result decoding

---
 kgcompass/llm_loc.py | 21 ++++++++++++++++++---
 tei/candidates.jsonl |  3 +++
 2 files changed, 21 insertions(+), 3 deletions(-)

diff --git a/kgcompass/llm_loc.py b/kgcompass/llm_loc.py
index 9bb3d2d..a9f630c 100644
--- a/kgcompass/llm_loc.py
+++ b/kgcompass/llm_loc.py
@@ -6,10 +6,25 @@ import openai
 from utils import get_commit_method_by_signature, extract_json_code as _extract_json_code, create_github_client
 
 def extract_json_code(text):
-    try:
-        return _extract_json_code(text)
-    except (ValueError, TypeError, json.JSONDecodeError):
+    if not isinstance(text, str):
         return {}
+    candidates = [text]
+    candidates.extend(re.findall(r"```(?:json)?\\s*(.*?)```", text, flags=re.S | re.I))
+    for candidate in candidates:
+        try:
+            parsed = _extract_json_code(candidate)
+            if isinstance(parsed, dict) and parsed:
+                return parsed
+        except (ValueError, TypeError, json.JSONDecodeError):
+            pass
+        for match in re.finditer(r"\\{.*?\\}", candidate, flags=re.S):
+            try:
+                parsed = json.loads(match.group(0))
+                if isinstance(parsed, dict):
+                    return parsed
+            except json.JSONDecodeError:
+                continue
+    return {}
 from config import (
     DATASET_NAME,
     DEEPSEEK_BASE_URL,
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index 0ed704c..c2c9166 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -1,3 +1,6 @@
 {"version_id": "struct-01", "phase": "structural", "technique": "Search all KG-location layouts instead of assuming one exact directory depth", "target_failure_mode": "Fault-localization or context-selection misses", "expected_dimension": "target_alignment", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/llm_loc.py", "find": "kg_location_files = glob.glob(f\"tests/{self.instance_id}_*/kg_locations/{self.instance_id}.json\")", "replace": "kg_location_files = sorted(set(\n            glob.glob(f\"tests/{self.instance_id}_*/kg_locations/{self.instance_id}.json\")\n            + glob.glob(f\"tests/**/{self.instance_id}.json\", recursive=True)\n            + glob.glob(f\"**/kg_locations/{self.instance_id}.json\", recursive=True)\n        ))"}, "dimensions": {"target_alignment": 0.73, "reasoning_soundness": 0.63, "execution_accuracy": 0.59, "output_integrity": 0.65}, "aggregate": 0.65, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.92}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.29}, {"instance_id": "django__django-11964", "score": 0.25}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0225, "why": "Broadening KG-location discovery directly addresses context-selection failures and should recover layouts missed by the fixed path assumption. The recursive searches add some false-positive and performance risk, so the gains are meaningful but limited."}
 {"version_id": "struct-02", "phase": "structural", "technique": "Make the localization API client retry transient failures and tolerate slow responses", "target_failure_mode": "Fault-localization or context-selection misses", "expected_dimension": "target_alignment", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/llm_loc.py", "find": "self.client = openai.OpenAI(api_key=BAILIAN_API_KEY, base_url=DEEPSEEK_BASE_URL)", "replace": "self.client = openai.OpenAI(\n            api_key=BAILIAN_API_KEY,\n            base_url=DEEPSEEK_BASE_URL,\n            max_retries=4,\n            timeout=180.0,\n        )"}, "dimensions": {"target_alignment": 0.7, "reasoning_soundness": 0.63, "execution_accuracy": 0.58, "output_integrity": 0.65}, "aggregate": 0.64, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.91}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.23}, {"instance_id": "django__django-11964", "score": 0.22}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0125, "why": "Retries and a longer timeout improve resilience to transient localization-service failures, but do not improve localization quality or patch correctness. The additional waiting can also make orchestration less efficient."}
 {"version_id": "struct-03", "phase": "structural", "technique": "Convert JSON-extraction exceptions into an explicit empty result rather than aborting orchestration", "target_failure_mode": "Brittle output and orchestration handling", "expected_dimension": "output_integrity", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/llm_loc.py", "find": "from utils import get_commit_method_by_signature, extract_json_code, create_github_client", "replace": "from utils import get_commit_method_by_signature, extract_json_code as _extract_json_code, create_github_client\n\ndef extract_json_code(text):\n    try:\n        return _extract_json_code(text)\n    except (ValueError, TypeError, json.JSONDecodeError):\n        return {}"}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.6, "execution_accuracy": 0.56, "output_integrity": 0.66}, "aggregate": 0.625, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.9}, {"instance_id": "django__django-12747", "score": 0.9}, {"instance_id": "django__django-13768", "score": 0.21}, {"instance_id": "django__django-11964", "score": 0.21}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": -0.0025, "why": "Returning an empty object prevents JSON extraction failures from aborting the run and modestly improves orchestration integrity. However, it silently converts malformed model output into missing context, which can weaken reasoning and leave failed probes unresolved."}
+{"version_id": "struct-04", "phase": "structural", "technique": "Isolate strict edit-command parsing failures behind a non-crashing adapter", "target_failure_mode": "Brittle output and orchestration handling", "expected_dimension": "output_integrity", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch,\n)\nfrom benchmark import create_benchmark_manager", "replace": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict as _parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch,\n)\n\ndef parse_diff_edit_commands_strict(*args, **kwargs):\n    try:\n        return _parse_diff_edit_commands_strict(*args, **kwargs)\n    except (ValueError, TypeError, IndexError):\n "}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.62, "execution_accuracy": 0.58, "output_integrity": 0.67}, "aggregate": 0.6375, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.91}, {"instance_id": "django__django-12747", "score": 0.9}, {"instance_id": "django__django-13768", "score": 0.22}, {"instance_id": "django__django-11964", "score": 0.23}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.01, "why": "Containing strict edit-parser failures keeps malformed candidate patches from crashing the workflow and improves output handling. It does not make malformed edits valid, so execution gains are small and silent rejection can still reduce effective resolution."}
+{"version_id": "struct-05", "phase": "structural", "technique": "Treat syntax-checker exceptions as validation failures instead of process failures", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch,\n)\nfrom benchmark import create_benchmark_manager", "replace": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax as _check_syntax,\n    applable_patch,\n)\n\ndef check_syntax(*args, **kwargs):\n    try:\n        return _check_syntax(*args, **kwargs)\n    except (OSError, subprocess.SubprocessError, ValueError, TypeError):\n        return False\n\nfrom benchm"}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.63, "execution_accuracy": 0.6, "output_integrity": 0.68}, "aggregate": 0.6475, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.92}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.24}, {"instance_id": "django__django-11964", "score": 0.24}], "score_label": "PROXY", "decision": "proposed_not_applied", "apply_note": "find-block matched 0x (need exactly 1)", "delta_vs_baseline": 0.02, "why": "Treating syntax-checker exceptions as failed validation is a useful safety boundary: invalid candidates can be rejected or retried instead of terminating orchestration. This improves execution and integrity more than parser-only handling, though it still does not repair the generated patch."}
+{"version_id": "struct-06", "phase": "structural", "technique": "Make patch-application errors return a failed candidate status", "target_failure_mode": "Patch generation and application failures", "expected_dimension": "execution_accuracy", "evidence_instance_ids": ["django__django-15213", "django__django-12747", "django__django-13768", "django__django-11964"], "patch_or_prompt": {"file": "kgcompass/repair.py", "find": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch,\n)\nfrom benchmark import create_benchmark_manager", "replace": "from utils import (\n    format_entity_content,\n    extract_python_blocks,\n    split_edit_multifile_commands,\n    parse_diff_edit_commands_strict,\n    check_syntax,\n    applable_patch as _applable_patch,\n)\n\ndef applable_patch(*args, **kwargs):\n    try:\n        return _applable_patch(*args, **kwargs)\n    except (OSError, subprocess.SubprocessError, ValueError, TypeError):\n        return False\n\nfrom "}, "dimensions": {"target_alignment": 0.68, "reasoning_soundness": 0.63, "execution_accuracy": 0.61, "output_integrity": 0.69}, "aggregate": 0.6525, "probe_scores": [{"instance_id": "django__django-15213", "score": 0.92}, {"instance_id": "django__django-12747", "score": 0.91}, {"instance_id": "django__django-13768", "score": 0.26}, {"instance_id": "django__django-11964", "score": 0.25}], "score_label": "PROXY", "decision": "proposed_not_applied", "apply_note": "find-block matched 0x (need exactly 1)", "delta_vs_baseline": 0.025, "why": "Converting patch-application exceptions into explicit failed-candidate results most directly addresses brittle execution and allows orchestration to retry or select another candidate. It improves reliability and integrity, but cannot increase success when the underlying patch is intrinsically incorrect."}
