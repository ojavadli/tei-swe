Subject: [PATCH 24/28] tei-v7 struct-26: Replace first-match JSON extraction
 with balanced JSONDecode

---
 kgcompass/llm_loc.py | 11 +++++++++++
 tei/candidates.jsonl |  1 +
 2 files changed, 12 insertions(+)

diff --git a/kgcompass/llm_loc.py b/kgcompass/llm_loc.py
index a3c0ac2..f9e6057 100644
--- a/kgcompass/llm_loc.py
+++ b/kgcompass/llm_loc.py
@@ -12,6 +12,17 @@ from utils import get_commit_method_by_signature, extract_json_code as _extract_
 def extract_json_code(text):
     if not isinstance(text, str):
         return {}
+    decoder = json.JSONDecoder()
+    for start, char in enumerate(text):
+        if char != '{':
+            continue
+        try:
+            parsed, _ = decoder.raw_decode(text[start:])
+            if isinstance(parsed, dict) and parsed:
+                return parsed
+        except (ValueError, TypeError, json.JSONDecodeError):
+            continue
+    return {}
     candidates = [text]
     candidates.extend(re.findall(r"```(?:json)?\s*(.*?)```", text, flags=re.S | re.I))
     for candidate in candidates:
