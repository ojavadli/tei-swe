From 91c011e16b3b69aff64bbf5f5cc21ccef8c59758 Mon Sep 17 00:00:00 2001
From: Orkhan Javadli <ojavadli@gmail.com>
Date: Sat, 8 Aug 2026 12:39:34 -0700
Subject: [PATCH 02/28] tei-v7 struct-02: Prepend an explicit reconnaissance
 step to every generated p

---
 patchwork/common/multiturn_strategy/planning_strategy.py | 3 ++-
 tei/candidates.jsonl                                     | 1 +
 2 files changed, 3 insertions(+), 1 deletion(-)

diff --git a/patchwork/common/multiturn_strategy/planning_strategy.py b/patchwork/common/multiturn_strategy/planning_strategy.py
index e15c5e8..11b132d 100644
--- a/patchwork/common/multiturn_strategy/planning_strategy.py
+++ b/patchwork/common/multiturn_strategy/planning_strategy.py
@@ -27,7 +27,8 @@ class ExecutionResult(BaseModel):
 
 class _Plan:
     def __init__(self, initial_plan: Optional[list[str]] = None):
-        self.__plan = initial_plan or []
+        reconnaissance = "Inspect repository structure, relevant symbols, neighboring implementations, and existing tests"
+        self.__plan = [reconnaissance, *(initial_plan or [])]
         self.__cursor = 0
 
     def advance(self) -> bool:
diff --git a/tei/candidates.jsonl b/tei/candidates.jsonl
index e69de29..90306d9 100644
--- a/tei/candidates.jsonl
+++ b/tei/candidates.jsonl
@@ -0,0 +1 @@
+{"version_id": "struct-01", "phase": "structural", "technique": "Inject a repository-aware execution contract into every agent conversation", "target_failure_mode": "Repository- and issue-type generalization failure", "expected_dimension": "target_alignment", "evidence_instance_ids": ["sympy__sympy-20154", "sympy__sympy-15011", "django__django-11001", "django__django-11910"], "patch_or_prompt": {"file": "patchwork/common/multiturn_strategy/agentic_strategy.py", "find": "    def generate_reply(self, message: str) -> str:\n        self.history.append(dict(role=\"user\", content=message))\n        input_kwargs = dict(", "replace": "    def generate_reply(self, message: str) -> str:\n        if not self.history:\n            self.history.append({\n                \"role\": \"system\",\n                \"content\": \"Work repository-first: inspect the target repository's conventions, neighboring implementations, tests, and supported versions before editing. Prefer the smallest compatible patch and verify it with focused tests.\"\n         "}, "dimensions": {"target_alignment": 0.67, "reasoning_soundness": 0.62, "execution_accuracy": 0.5, "output_integrity": 0.57}, "aggregate": 0.59, "probe_scores": [{"instance_id": "sympy__sympy-20154", "score": 0.81}, {"instance_id": "sympy__sympy-15011", "score": 0.79}, {"instance_id": "django__django-11001", "score": 0.23}, {"instance_id": "django__django-11910", "score": 0.21}], "score_label": "PROXY", "decision": "applied", "apply_note": "applied+committed", "delta_vs_baseline": 0.0425, "why": "The repository-aware contract directly addresses cross-repository generalization by requiring inspection of conventions, neighboring code, tests, and supported versions. It improves target selection and reasoning most, with smaller gains in execution and output discipline, but it remains prompt guidance rather than enforced behavior."}
